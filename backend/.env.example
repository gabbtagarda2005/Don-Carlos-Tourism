# Server
PORT=5000
NODE_ENV=development

# MongoDB — local or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/don-carlos-tourism

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# Allowed frontend origins (comma-separated). Leave empty to allow all.
# Example: https://don-carlos-tourism.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# First admin account — created automatically on first start if no admin exists
ADMIN_EMAIL=admin@doncarlos.gov.ph
ADMIN_PASSWORD=ChangeMe123!

# Seed sample spots / events / businesses on first start when the DB is empty (true/false)
SEED_SAMPLE_DATA=true
